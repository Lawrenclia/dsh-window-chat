{
  "name": "@local/window-chat",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "DSH Web UI plugin: chat between the current conversation window and another conversation window.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "chat",
    "session"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}